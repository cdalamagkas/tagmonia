#!/bin/sh
# Sets a local account's password, for when nobody can sign in: docker exec -it tagmonia reset-password [username]
# The username defaults to "admin". Writes only the database under TAGMONIA_CONFIG_DIR, as PUID:PGID (D72), so
# `docker exec` (root by default) never leaves files Tagmonia cannot write.
set -eu
run() {
  exec deno run --quiet --cached-only --node-modules-dir=none --allow-read --allow-env \
    --allow-write="${TAGMONIA_CONFIG_DIR:-/config}" /app/server/cli/reset_password.ts "$@"
}
if [ "$(id -u)" = "0" ]; then
  exec setpriv --reuid="${PUID:-1000}" --regid="${PGID:-1000}" --clear-groups --no-new-privs -- "$0" "$@"
fi
run "$@"
