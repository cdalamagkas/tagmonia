{
  "workspace": [
    "./vendor/harmony"
  ],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.16",
    "@std/path": "jsr:@std/path@1.1.6",
    "hash-wasm": "npm:hash-wasm@4.12.0",
    "hono": "npm:hono@4.13.17",
    "hono/": "npm:/hono@4.13.17/",
    "zod": "npm:zod@4.6.7",
    "taglib-wasm": "npm:taglib-wasm@2.4.1",
    "preact": "npm:preact@10.29.8",
    "preact/": "npm:/preact@10.29.8/",
    "vite": "npm:vite@7.3.7",
    "@preact/preset-vite": "npm:@preact/preset-vite@2.10.6"
  },
  "tasks": {
    "dev": "deno task dev:server & deno task dev:web",
    "dev:server": "mkdir -p dev/music dev/config && TAGMONIA_MUSIC_DIR=dev/music TAGMONIA_CONFIG_DIR=dev/config deno run --watch=server/ --allow-net --allow-read --allow-write --allow-env --allow-run=python3 server/main.ts",
    "dev:web": "deno task web:install && deno run -A npm:vite@7.3.7 web --host 0.0.0.0",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run=python3 server/main.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-run=python3 tests/",
    "test:tagio": "deno test --allow-read --allow-write --allow-env --allow-run=python3 tests/tagio/",
    "fixtures": "scripts/gen_fixtures.sh",
    "check": "deno check server/ shared/ web/src/ tests/ scripts/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "build": "deno task check && deno task web:install && deno run -A npm:vite@7.3.7 build web",
    "web:install": "deno install --entrypoint web/vite.config.ts web/src/main.tsx"
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "vendor/",
      "web/dist/",
      "dist/",
      "tests/fixtures/",
      "brand/",
      "dev/",
      "node_modules/",
      "docs/",
      "CLAUDE.md"
    ],
    "proseWrap": "preserve"
  },
  "lint": {
    "exclude": [
      "vendor/",
      "web/dist/",
      "dist/",
      "tests/fixtures/",
      "dev/",
      "node_modules/"
    ]
  },
  "test": {
    "exclude": [
      "vendor/"
    ]
  },
  "exclude": [
    "web/dist/",
    "dist/",
    "node_modules/",
    "dev/"
  ]
}
